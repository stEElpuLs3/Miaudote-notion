# Backend environment variables
# Exemplo de configuração para deploy em produção.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/nomeDoBanco?retryWrites=true&w=majority
JWT_SECRET=uma-string-bem-longa-e-secreta
BASE_URL=https://seu-backend.onrender.com
PORT=3001
CORS_ORIGINS=https://seu-frontend.vercel.app,https://outro-domínio.com
EMAIL_USER=seu-email@example.com
EMAIL_PASSWORD=sua-senha-de-app
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=seu-api-key
CLOUDINARY_API_SECRET=seu-api-secret
